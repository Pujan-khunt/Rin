{
  "name": "rin-solver",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "routes": [
    {
      "pattern": "rin-worker.pujankhunt.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
