{
  "name": "rin-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "build": "pnpm -r run build",
    "build:firefox": "pnpm --filter @rin/extension build:firefox",
    "typecheck": "pnpm -r run typecheck",
    "zip": "pnpm --filter @rin/extension zip",
    "zip:firefox": "pnpm --filter @rin/extension zip:firefox",
    "zip:all": "pnpm --filter @rin/extension zip:all",
    "zip:source": "git archive --format=zip --output=rin-sources.zip HEAD"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "jsdom": "^25.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.5.5"
  }
}
